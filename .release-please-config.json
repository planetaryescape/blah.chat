{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false
    },
    "packages/api-client": {
      "release-type": "node",
      "component": "api-client",
      "package-name": "@blah-chat/api-client",
      "include-component-in-tag": true
    },
    "packages/ai": {
      "release-type": "node",
      "component": "ai",
      "package-name": "@blah-chat/ai",
      "include-component-in-tag": true
    },
    "packages/shared": {
      "release-type": "node",
      "component": "shared",
      "package-name": "@blah-chat/shared",
      "include-component-in-tag": true
    },
    "packages/config": {
      "release-type": "node",
      "component": "config",
      "package-name": "@blah-chat/config",
      "include-component-in-tag": true
    },
    "packages/auto-router": {
      "release-type": "node",
      "component": "auto-router",
      "package-name": "@blah-chat/auto-router",
      "include-component-in-tag": true
    },
    "packages/sdk": {
      "release-type": "node",
      "component": "sdk",
      "package-name": "@blah-chat/sdk",
      "include-component-in-tag": true
    },
    "packages/jobs": {
