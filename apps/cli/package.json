{
  "name": "@blah-chat/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "blah": "./bin/blah.js"
  },
  "main": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./lib/queries": "./src/lib/queries.ts",
    "./lib/mutations": "./src/lib/mutations.ts",
    "./lib/client": "./src/lib/client.ts",
    "./lib/config": "./src/lib/config.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "build": "bun run scripts/build.ts",
    "compile": "bun run scripts/compile.ts",
    "publish:npm": "bun run scripts/publish.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@blah-chat/api-client": "workspace:*",
    "@blah-chat/chat-ui-core": "workspace:*",
    "@blah-chat/shared": "workspace:*",
    "@opentui/core": "^0.1.74",
    "@opentui/solid": "^0.1.72",
    "solid-js": "^1.9.0",
    "clipboardy": "^5.0.2",
    "commander": "^14.0.3",
    "conf": "^15.0.2",
    "marked": "12",
    "marked-terminal": "^7.3.0",
    "open": "^11.0.0",
    "tree-sitter-wasms": "^0.1.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "2.3.14",
    "@types/node": "^25.0.10",
    "babel-preset-solid": "^1.9.10",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
