{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-shell",
  "description": "Desktop shell capability for main and companion windows.",
  "windows": ["main", "companion"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "global-shortcut:default",
    "notification:default"
  ],
  "urls": [
    "https://blah.chat/*",
    "https://*.blah.chat/*",
    "http://localhost:3000/*",
    "blah-offline://*"
  ]
}
