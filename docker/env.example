# Safe local defaults for Docker Compose. Copy to .env.docker and replace the
# external service keys before using chat, auth, or background jobs.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth. Replace with values from https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
CLERK_ISSUER_DOMAIN=replace-me.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Vercel AI Gateway. Required for non-BYOK chat.
# AI_GATEWAY_API_KEY=

# Trigger.dev. Required for resilient generation and the optional jobs profile.
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=https://api.trigger.dev
# TRIGGER_ACCESS_TOKEN=
INTERNAL_TASK_SECRET=local-internal-task-secret-change-me
INTERNAL_TASK_BASE_URL=http://localhost:3000

# Local infrastructure. docker-compose.yml overrides these to container-network
# URLs for the web/jobs containers; these host URLs work with docker-compose.dev.yml.
DATABASE_URL=postgres://blah:blah@localhost:55432/blah_chat
UPSTASH_REDIS_REST_URL=http://localhost:58079
UPSTASH_REDIS_REST_TOKEN=dev-token
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=blah-chat-dev
R2_ENDPOINT=http://localhost:59000
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=true

# Local-only encryption key. Change before storing real BYOK/BYOD secrets.
BYOD_ENCRYPTION_KEY=local-dev-change-me-before-production

DEFAULT_DAILY_MESSAGE_LIMIT=50
DEFAULT_MONTHLY_BUDGET=10
BUDGET_ALERT_THRESHOLD=0.8
BUDGET_HARD_LIMIT_ENABLED=true
TELEMETRY_DISABLED=1
APP_VERSION=docker-local

# Optional integrations.
# TAVILY_API_KEY=
# JINA_API_KEY=
# E2B_API_KEY=
# FIRECRAWL_API_KEY=
# COMPOSIO_API_KEY=
# GROQ_API_KEY=
# DEEPGRAM_API_KEY=
# RESEND_API_KEY=
