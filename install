#!/bin/bash
set -e

# blah.chat CLI installer
# Usage: curl -fsSL https://blah.chat/install | bash

REPO="planetaryescape/blah.chat"
INSTALL_DIR="${BLAH_INSTALL_DIR:-$HOME/.blah/bin}"
BINARY_NAME="blah"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}==>${NC} $1"; }
success() { echo -e "${GREEN}==>${NC} $1"; }
warn() { echo -e "${YELLOW}==>${NC} $1"; }
error() { echo -e "${RED}==>${NC} $1" >&2; exit 1; }

# Detect platform
detect_platform() {
  local os arch

  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux) os="linux" ;;
    MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    *) error "Unsupported operating system: $(uname -s)" ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64) arch="x64" ;;
    arm64|aarch64) arch="arm64" ;;
    *) error "Unsupported architecture: $(uname -m)" ;;
  esac

  echo "${os}-${arch}"
}

# Get latest release tag
get_latest_version() {
  local url="https://api.github.com/repos/${REPO}/releases/latest"

  if command -v curl &>/dev/null; then
    curl -fsSL "$url" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/'
  elif command -v wget &>/dev/null; then
    wget -qO- "$url" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/'
  else
    error "Neither curl nor wget found. Please install one of them."
  fi
}

# Download file
download() {
  local url="$1"
  local dest="$2"

  if command -v curl &>/dev/null; then
    curl -fsSL --progress-bar "$url" -o "$dest"
  elif command -v wget &>/dev/null; then
    wget -q --show-progress "$url" -O "$dest"
  fi
}

# Add to PATH in shell config
add_to_path() {
  local shell_config=""
  local path_line="export PATH=\"\$HOME/.blah/bin:\$PATH\""

  # Detect shell config file
  if [ -n "$ZSH_VERSION" ] || [ "$SHELL" = "/bin/zsh" ] || [ "$SHELL" = "/usr/bin/zsh" ]; then
    shell_config="$HOME/.zshrc"
  elif [ -n "$BASH_VERSION" ] || [ "$SHELL" = "/bin/bash" ] || [ "$SHELL" = "/usr/bin/bash" ]; then
    if [ -f "$HOME/.bashrc" ]; then
      shell_config="$HOME/.bashrc"
    elif [ -f "$HOME/.bash_profile" ]; then
      shell_config="$HOME/.bash_profile"
    else
      shell_config="$HOME/.profile"
    fi
  else
    shell_config="$HOME/.profile"
  fi

  # Check if already in PATH
  if echo "$PATH" | grep -q "$HOME/.blah/bin"; then
    return 0
  fi

  # Check if already in config
  if [ -f "$shell_config" ] && grep -q ".blah/bin" "$shell_config"; then
    return 0
  fi

  # Add to config
  echo "" >> "$shell_config"
  echo "# blah.chat CLI" >> "$shell_config"
  echo "$path_line" >> "$shell_config"

  warn "Added $INSTALL_DIR to PATH in $shell_config"
  warn "Run 'source $shell_config' or start a new terminal to use blah"
}

main() {
  info "Installing blah.chat CLI..."

  local platform
  platform=$(detect_platform)
  info "Detected platform: $platform"

  local version
  version=$(get_latest_version)
  if [ -z "$version" ]; then
    error "Failed to get latest version. Check your internet connection."
  fi
  info "Latest version: $version"

  # Construct download URL
  local archive_name="blah-cli-${platform}"
  local archive_ext="tar.gz"
  if [ "$platform" = "windows-x64" ]; then
    archive_ext="zip"
  fi
  local download_url="https://github.com/${REPO}/releases/download/${version}/${archive_name}.${archive_ext}"

  # Create temp directory
  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap "rm -rf $tmp_dir" EXIT

  local archive_path="${tmp_dir}/${archive_name}.${archive_ext}"

  info "Downloading from $download_url..."
  download "$download_url" "$archive_path"

  # Extract
  info "Extracting..."
  cd "$tmp_dir"
  if [ "$archive_ext" = "tar.gz" ]; then
    tar -xzf "$archive_path"
  else
    unzip -q "$archive_path"
  fi

  # Create install directory
  mkdir -p "$INSTALL_DIR"

  # Copy binary
  local binary_name="$BINARY_NAME"
  if [ "$platform" = "windows-x64" ]; then
    binary_name="${BINARY_NAME}.exe"
  fi

  cp "${archive_name}/${binary_name}" "$INSTALL_DIR/"
  chmod +x "$INSTALL_DIR/$binary_name"

  # Copy assets (tree-sitter files)
  if [ -d "${archive_name}/assets" ]; then
    mkdir -p "$HOME/.blah"
    cp -r "${archive_name}/assets" "$HOME/.blah/"
  fi

  success "Installed to $INSTALL_DIR/$binary_name"

  # Add to PATH
  add_to_path

  echo ""
  success "Installation complete!"
  info "Run 'blah --help' to get started"
}

main "$@"
