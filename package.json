{
  "name": "blah-chat",
  "version": "1.40.3",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "dev:infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "db:generate": "bun --filter=@blah-chat/persistence-postgres run db:generate",
    "db:migrate": "bun --filter=@blah-chat/persistence-postgres run db:migrate",
    "db:push": "bun --filter=@blah-chat/persistence-postgres run db:push",
    "db:studio": "bun --filter=@blah-chat/persistence-postgres run db:studio",
    "package-docs:check": "bun run scripts/check-package-docs.ts",
    "trigger:dev": "bun --filter=@blah-chat/jobs run dev",
    "prepare": "node scripts/prepare.mjs",
    "api-client:generate": "bun --filter=@blah-chat/api-client run generate",
    "api-client:check": "bun run api-client:generate && git diff --exit-code packages/api-client/src/generated/openapi.ts",
    "api-client:version:auto": "bun run scripts/auto-bump-api-client-version.ts",
    "api-client:version-check": "bun run scripts/check-api-client-version-bump.ts",
    "desktop:version-check": "bun run scripts/check-desktop-version-sync.ts",
    "model:add": "bun run scripts/model-cli.ts add",
    "model:list": "bun run scripts/model-cli.ts list",
    "model:get": "bun run scripts/model-cli.ts get",
    "model:update": "bun run scripts/model-cli.ts update",
    "model:deprecate": "bun run scripts/model-cli.ts deprecate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "lefthook": "^2.0.12",
    "turbo": "^2.3.0"
  },
  "dependencies": {
    "bible-passage-reference-parser": "^3.1.0"
  }
}
