{
  "name": "blah-chat",
  "version": "1.22.3",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "convex": "bun --filter=@blah-chat/backend run dev",
    "convex:deploy": "bun --filter=@blah-chat/backend run deploy",
    "prepare": "lefthook install",
    "byod:sync": "bun run scripts/sync-byod-schema.ts",
    "sdk:generate": "bun --filter=@blah-chat/sdk run generate",
    "sdk:check": "bun run sdk:generate && git diff --exit-code packages/sdk/src/generated/openapi.ts",
    "sdk:version:auto": "bun run scripts/auto-bump-sdk-version.ts",
    "sdk:version-check": "bun run scripts/check-sdk-version-bump.ts",
    "desktop:version-check": "bun run scripts/check-desktop-version-sync.ts",
    "portable:check": "bun run scripts/check-portable-imports.ts",
    "model:add": "bun run scripts/model-cli.ts add",
    "model:list": "bun run scripts/model-cli.ts list",
    "model:get": "bun run scripts/model-cli.ts get",
    "model:update": "bun run scripts/model-cli.ts update",
    "model:deprecate": "bun run scripts/model-cli.ts deprecate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "lefthook": "^2.0.12",
    "turbo": "^2.3.0"
  },
  "dependencies": {
    "bible-passage-reference-parser": "^3.1.0"
  }
}
