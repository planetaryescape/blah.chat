{
  "name": "blah-chat",
  "version": "1.45.1",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "package-docs:check": "bun run scripts/check-package-docs.ts",
    "convex": "bun --filter=@blah-chat/backend run dev",
    "convex:deploy": "bun --filter=@blah-chat/backend run deploy",
    "prepare": "node scripts/prepare.mjs",
    "byod:sync": "bun run scripts/sync-byod-schema.ts",
    "api-client:generate": "bun --filter=@blah-chat/api-client run generate",
    "api-client:check": "bun run api-client:generate && git diff --exit-code packages/api-client/src/generated/openapi.ts",
    "api-client:version:auto": "bun run scripts/auto-bump-api-client-version.ts",
    "api-client:version-check": "bun run scripts/check-api-client-version-bump.ts",
    "desktop:version-check": "bun run scripts/check-desktop-version-sync.ts",
    "portable:check": "bun run scripts/check-portable-imports.ts",
    "model:add": "bun run scripts/model-cli.ts add",
    "model:list": "bun run scripts/model-cli.ts list",
    "model:get": "bun run scripts/model-cli.ts get",
    "model:update": "bun run scripts/model-cli.ts update",
    "model:deprecate": "bun run scripts/model-cli.ts deprecate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "lefthook": "2.1.8",
    "turbo": "2.9.14"
  },
  "dependencies": {
    "bible-passage-reference-parser": "^3.2.0"
  },
  "resolutions": {
    "@types/react": "19.2.15",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "@clerk/clerk-react": "5.61.11",
    "@clerk/shared": "3.48.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@types/react": "19.2.15",
    "@vitest/coverage-v8": "4.1.8",
    "@protobufjs/utf8": "1.1.1",
    "@xmldom/xmldom": "0.8.15",
    "axios": "1.20.0",
    "bn.js": "5.2.3",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.4",
    "compression": "1.8.2",
    "cookie": "1.1.1",
    "decode-uri-component": "0.5.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.0",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "image-size": "2.0.4",
    "js-cookie": "3.0.8",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "markdown-it": "14.3.3",
    "mathjs": "15.2.0",
    "minimatch": "3.1.4",
    "nanoid": "5.1.16",
    "node-forge": "1.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.31",
    "prismjs": "1.30.0",
    "protobufjs": "7.6.1",
    "prosemirror-view": "1.42.8",
    "rollup": "4.60.4",
    "seroval": "1.7.2",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "socket.io-parser": "4.2.6",
    "systeminformation": "5.31.6",
    "tar": "7.5.22",
    "undici": "7.30.1",
    "underscore": "1.13.8",
    "uuid": "14.0.0",
    "vite": "7.3.7",
    "vitest": "4.1.8",
    "ws": "8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  }
}
