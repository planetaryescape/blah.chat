{
  "name": "@blah-chat/ai",
  "version": "0.4.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./operational-models": {
      "types": "./dist/operational-models.d.ts",
      "import": "./dist/operational-models.js"
    },
    "./reasoning": {
      "types": "./dist/reasoning/index.d.ts",
      "import": "./dist/reasoning/index.js"
    },
    "./prompts/taskExtraction": {
      "types": "./dist/prompts/taskExtraction.d.ts",
      "import": "./dist/prompts/taskExtraction.js"
    },
    "./prompts/meetingExtraction": {
      "types": "./dist/prompts/meetingExtraction.d.ts",
      "import": "./dist/prompts/meetingExtraction.js"
    },
    "./prompts/modelTriage": {
      "types": "./dist/prompts/modelTriage.d.ts",
      "import": "./dist/prompts/modelTriage.js"
    },
    "./prompts/triage": {
      "types": "./dist/prompts/triage.d.ts",
      "import": "./dist/prompts/triage.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/models.ts src/utils.ts src/gateway.ts src/registry.ts src/operational-models.ts src/reasoning/index.ts src/prompts/taskExtraction.ts src/prompts/meetingExtraction.ts src/prompts/modelTriage.ts src/prompts/triage.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/cerebras": "^2.0.2",
    "@ai-sdk/gateway": "^3.0.2",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/groq": "^3.0.0",
    "@ai-sdk/openai": "^3.0.1",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "ai": "^6.0.3",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@blah-chat/config": "workspace:*",
    "@types/node": "^25.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
