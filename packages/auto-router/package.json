{
  "name": "@blah-chat/auto-router",
  "version": "0.5.0",
  "description": "Two-stage LLM model router: hard rules + embedding similarity. Zero runtime deps, sub-5ms classification.",
  "type": "module",
  "license": "MIT",
  "author": "Bhekani Khumalo",
  "repository": {
    "type": "git",
    "url": "https://github.com/planetaryescape/blah.chat",
    "directory": "packages/auto-router"
  },
  "keywords": [
    "llm",
    "model-router",
    "ai",
    "embedding",
    "classifier",
    "openai",
    "anthropic",
    "gemini",
    "model-selection"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./bins": {
      "types": "./dist/bins.d.ts",
      "import": "./dist/bins.js"
    },
    "./hard-rules": {
      "types": "./dist/hard-rules.d.ts",
      "import": "./dist/hard-rules.js"
    },
    "./classifier": {
      "types": "./dist/classifier.d.ts",
      "import": "./dist/classifier.js"
    },
    "./bin-selector": {
      "types": "./dist/bin-selector.d.ts",
      "import": "./dist/bin-selector.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "import": "./dist/embedding.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./policy-engine": {
      "types": "./dist/policy-engine.d.ts",
      "import": "./dist/policy-engine.js"
    },
    "./exploration": {
      "types": "./dist/exploration.d.ts",
      "import": "./dist/exploration.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/profiles.ts src/prompts.ts src/types.ts src/bins.ts src/hard-rules.ts src/classifier.ts src/bin-selector.ts src/examples.ts src/router.ts src/embedding.ts src/registry.ts src/policy-engine.ts src/exploration.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
