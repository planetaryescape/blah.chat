{
  "name": "@blah-chat/backend",
  "version": "0.0.0",
  "private": true,
  "main": "./convex/index.ts",
  "types": "./convex/_generated/dataModel.d.ts",
  "exports": {
    "./*": "./convex/*",
    "./_generated/*": "./convex/_generated/*",
    "./convex/_generated/api": "./convex/_generated/api.js",
    "./convex/_generated/dataModel": "./convex/_generated/dataModel.d.ts"
  },
  "scripts": {
    "dev": "bun --filter=@blah-chat/ai run build && bun --filter=@blah-chat/shared run build && bun --filter=@blah-chat/auto-router run build && bun --filter=@blah-chat/cognitive-memory run build && convex dev",
    "deploy": "bun --filter=@blah-chat/ai run build && bun --filter=@blah-chat/shared run build && bun --filter=@blah-chat/auto-router run build && bun --filter=@blah-chat/cognitive-memory run build && convex deploy",
    "generate": "bun --filter=@blah-chat/ai run build && bun --filter=@blah-chat/shared run build && bun --filter=@blah-chat/auto-router run build && bun --filter=@blah-chat/cognitive-memory run build && convex codegen",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@blah-chat/ai": "workspace:*",
    "@blah-chat/auto-router": "workspace:*",
    "@blah-chat/cognitive-memory": "workspace:*",
    "@blah-chat/shared": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/gateway": "^3.0.2",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@anthropic-ai/sdk": "^0.78.0",
    "@composio/core": "^0.6.3",
    "@composio/vercel": "^0.6.2",
    "@convex-dev/resend": "^0.2.10",
    "@e2b/code-interpreter": "^2.3.3",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/ai-sdk-provider": "^2.0.2",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.0",
    "@tavily/ai-sdk": "^0.4.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "ai": "^6.0.3",
    "convex": "1.48.0",
    "convex-helpers": "^0.1.108",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jszip": "^3.10.1",
    "marked": "^17.0.1",
    "mathjs": "15.2.0",
    "nanoid": "5.1.16",
    "pdf-lib": "^1.17.1",
    "posthog-node": "^5.18.0",
