    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remove-markdown": "^0.6.2",
    "svix": "^1.82.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "mammoth": "^1.11.0",
    "officeparser": "^6.0.1",
    "sharp": "0.35.5",
    "tiktoken": "^1.0.22",
    "unpdf": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "convex-test": "^0.0.41",
