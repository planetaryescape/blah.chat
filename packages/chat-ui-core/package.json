{
  "name": "@blah-chat/chat-ui-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drafts": {
      "types": "./dist/drafts.d.ts",
      "import": "./dist/drafts.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/drafts.ts src/commands.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test:run": "bunx vitest run",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@blah-chat/config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
