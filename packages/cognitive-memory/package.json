{
  "name": "@blah-chat/cognitive-memory",
  "version": "0.2.0",
  "description": "Human-like memory for AI agents with Ebbinghaus decay, spaced repetition, and associative linking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js"
    },
    "./adapters/jsonl": {
      "types": "./dist/adapters/jsonl.d.ts",
      "import": "./dist/adapters/jsonl.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/adapters/postgres.ts src/adapters/jsonl.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "memory",
    "cognitive",
    "ebbinghaus",
    "spaced-repetition",
    "forgetting-curve",
    "associative-memory",
    "llm",
    "chatbot"
  ],
  "author": "Bhekani Khumalo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/planetaryescape/blah.chat",
    "directory": "packages/cognitive-memory"
  },
  "peerDependencies": {
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
