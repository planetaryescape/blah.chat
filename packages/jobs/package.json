{
  "name": "@blah-chat/jobs",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "bunx trigger.dev@latest dev",
    "deploy:trigger": "bunx trigger.dev@latest deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "@blah-chat/config": "workspace:*"
  },
  "dependencies": {
    "@blah-chat/ai": "workspace:*",
    "@blah-chat/persistence-postgres": "workspace:*",
    "@blah-chat/shared": "workspace:*",
    "@trigger.dev/sdk": "^4.4.3",
    "ai": "^6.0.3",
    "drizzle-orm": "^0.44.7",
    "zod": "^4.2.1"
  }
}
